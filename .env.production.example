HOST=0.0.0.0
PORT=5100
AI_GW_SERVE_FRONTEND=true
AI_GW_PERSISTENCE=postgres
AI_GW_DATABASE_URL=postgresql://postgres:password@postgres:5432/jetlinkapi
AI_GW_DATABASE_POOL_MAX=10
AI_GW_API_KEY_PEPPER=replace-with-a-stable-private-pepper
AI_GW_PROVIDER_SECRET_KEY=replace-with-a-stable-private-provider-secret-key
AI_GW_BOOTSTRAP_ADMIN_KEY=replace-with-first-admin-key
AI_GW_BOOTSTRAP_ADMIN_PER_MINUTE=600
AI_GW_DISABLE_DEV_KEYS=true
AI_GW_SUPER_ADMIN_USERNAME=admin
AI_GW_SUPER_ADMIN_PASSWORD=replace-with-super-admin-password
AI_GW_SUPER_ADMIN_NAME=超级管理员
AI_GW_PUBLIC_BASE_URL=https://ai-gw.jetlinks.cn
AI_GW_CORS_ORIGINS=https://ai-gw.jetlinks.cn
