# Copy to .env.production and fill in the required values.
WORMHOLE_IMAGE_TAG=latest
WORMHOLE_PORT=5100

POSTGRES_PASSWORD=
AI_GW_SUPER_ADMIN_USERNAME=admin
AI_GW_SUPER_ADMIN_PASSWORD=
AI_GW_SUPER_ADMIN_NAME=超级管理员
AI_GW_PUBLIC_BASE_URL=https://1024012.xyz
AI_GW_CORS_ORIGINS=https://1024012.xyz

# Generate a separate value for each secret with openssl rand -hex 32.
# Keep these stable across upgrades and include them in secure backups.
AI_GW_API_KEY_PEPPER=
AI_GW_PROVIDER_SECRET_KEY=
AI_GW_USER_KEY_SECRET=

# Optional credentials. The web console uses the administrator login above.
AI_GW_BOOTSTRAP_ADMIN_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# Upload the WeChat QR code in the admin console. Set a token only for the shortcut you use.
AI_GW_WECHAT_RECEIPT_TOKEN=
# Optional: historical Alipay orders only. Use a different secret.
AI_GW_ALIPAY_RECEIPT_TOKEN=
